# _headers — Security response headers
#
# IMPORTANT — GitHub Pages limitation:
#   Native GitHub Pages does NOT read or apply this file.  Response headers on
#   GitHub Pages are controlled entirely by GitHub's infrastructure and cannot
#   be customised per-repository.
#
#   This file IS applied when the site is served through a CDN/proxy layer that
#   honours the Netlify / Cloudflare Pages `_headers` convention, such as:
#     - Cloudflare Pages  (https://developers.cloudflare.com/pages/configuration/headers/)
#     - Netlify           (https://docs.netlify.com/routing/headers/)
#
#   For pure GitHub Pages deployments the <meta http-equiv="Content-Security-Policy">
#   tags inside each HTML page act as a partial, client-side CSP mitigation.
#   However, headers that MUST be real HTTP headers (HSTS, X-Frame-Options,
#   frame-ancestors, X-Content-Type-Options) only work at the network/CDN layer.
#
# ---------------------------------------------------------------------------

/*
  # Prevent MIME-type sniffing (must be a real HTTP header to be effective)
  X-Content-Type-Options: nosniff

  # Control how much referrer information is sent to other origins
  Referrer-Policy: strict-origin-when-cross-origin

  # Prevent this site from being embedded in frames on any other origin
  # (defence against clickjacking; works in tandem with CSP frame-ancestors)
  X-Frame-Options: DENY

  # Enforce HTTPS for one year; include all subdomains
  # Only sent over HTTPS connections — safe to include here
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Restrict browser feature access to minimum required
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Content Security Policy
  # Covers all five static pages; contact.html connect-src includes the API.
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://api.ifreelance4u.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.ifreelance4u.com; upgrade-insecure-requests

# Static assets — long cache, immutable where appropriate
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
